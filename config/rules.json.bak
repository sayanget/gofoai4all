{
  "metrics": {
    "到达准点率": {
      "control_level": "考核",
      "data_source": "https://acnjh1thgeif.feishu.cn/sheets/KMqBsrOsAhkepOtmYhrcSM23nqh?sheet=307Usp",
      "description": "实际到达时间 <= 计划到达时间 + 60分钟 记为准点。计算公式：准点到达班次量 / 总到达班次量",
      "red_line": 0.92
    },
    "卸车及时率": {
      "control_level": "考核",
      "data_source": "https://acnjh1thgeif.feishu.cn/sheets/KMqBsrOsAhkepOtmYhrcSM23nqh?sheet=307Usp",
      "description": "准点卸车车次数 / (准点 + 晚点 + 漏卸车 + 本站发车未扫袋牌车次)。",
      "red_line": 0.95
    },
    "发车准点率": {
      "control_level": "考核",
      "data_source": "https://acnjh1thgeif.feishu.cn/sheets/KMqBsrOsAhkepOtmYhrcSM23nqh?sheet=307Usp",
      "description": "实际发车时间 <= 计划发车时间 + 30分钟 记为准点。计算公式：准点发车班次量 / 总发车班次量",
      "red_line": 0.95
    },
    "当班次发货及时率": {
      "control_level": "考核",
      "data_source": "https://acnjh1thgeif.feishu.cn/sheets/KMqBsrOsAhkepOtmYhrcSM23nqh?sheet=307Usp",
      "description": "本操作班次内，各流向货物在运力截单时间前到件，且于计划发车时间前完成发车的比例。公式：各运输批次计划发车前发出票数 ÷ 对应运输批次应发票总数。其中分母(应发票数)需区分场景：单批次场景下为本批次截单前到达票数；多批次场景下为(前序批次落货票数 + 本批次截单前到达票数)。到件时间优先采用中心到件时间或部门到车时间，次之集包时间-1小时。"
    },
    "班次发货及时率": {
      "control_level": "考核",
      "data_source": "https://acnjh1thgeif.feishu.cn/sheets/KMqBsrOsAhkepOtmYhrcSM23nqh?sheet=307Usp",
      "description": "以流向的运输批次为单位，在每个运输批次截单时间之前到达的包裹，需在该批次计划发车时间前发出。公式：分子(在计划发车时间前完成发车的票数) ÷ 分母(Hub操作班次内各发车流向每一班运力截单时间前到达的票数)。到件时间优先采用GPS到车时间，次之集包时间；实际发车时间优先电子围栏时间，次之人工发车时间。"
    },
    "线路装载率": {
      "control_level": "通晒",
      "data_source": "https://acnjh1thgeif.feishu.cn/sheets/KMqBsrOsAhkepOtmYhrcSM23nqh?sheet=307Usp",
      "description": "综合装载率 = SUM(路段装载率_i * 路段英里数_i) / 线路总英里数。车型财务分母：53' Trailer=12000, 26' Boxtruck=4000, 22' Box Truck=3385, 16' Box Truck=1615, 15' Box Truck=1615, Cargo Van=1480。",
      "red_line": 0.5
    },
    "跨班次发货及时率": {
      "control_level": "考核",
      "data_source": "https://acnjh1thgeif.feishu.cn/sheets/KMqBsrOsAhkepOtmYhrcSM23nqh?sheet=307Usp",
      "description": "考核跨班次流转。前一个操作班次（中转班次）遗留的、在最晚截单前到货的票，必须在下一操作班次对应流向的最晚计划发车时间前发走。公式：分子(前一个操作班次内、对应流向最晚截单时间前到货的票数中，在当前操作班次对应流向最晚计划发车时间前完成发车的票数) ÷ 分母(前一个操作班次内，各流向最晚截单时间前到货的总票数)。到件时间优先采用中心到件时间或部门到车时间，次之集包时间-1小时。"
    }
  },
  "vehicle_capacity": {
    "16' Box Truck": 1615,
    "26' Boxtruck": 38,
    "53' Trailer": 110,
    "Cargo Van": 1480
  }
}